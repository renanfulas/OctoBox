[Unit]
Description=OctoBOX Curva transactional outbox
After=network-online.target octobox-gunicorn.service

[Service]
Type=oneshot
WorkingDirectory=/srv/octobox/current
EnvironmentFile=-/srv/octobox/current/.release.env
EnvironmentFile=-/srv/octobox/shared/octobox.env
ExecStart=/srv/octobox/current/venv/bin/python manage.py drain_public_workout_outbox --limit 50
User=octobox
Group=octobox
UMask=0077
