[Unit]
Description=OctoBOX Curva transactional outbox
After=network-online.target octobox-gunicorn.service

[Service]
Type=oneshot
WorkingDirectory=/srv/octobox/app
EnvironmentFile=-/srv/octobox/shared/octobox.env
ExecStart=/srv/octobox/venv/bin/python manage.py drain_public_workout_outbox --limit 50
User=root
