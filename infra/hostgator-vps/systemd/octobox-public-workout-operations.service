[Unit]
Description=OctoBOX Curva operational work reconciliation
After=network-online.target octobox-gunicorn.service

[Service]
Type=oneshot
WorkingDirectory=/srv/octobox/app
EnvironmentFile=-/srv/octobox/shared/octobox.env
ExecStart=/srv/octobox/venv/bin/python manage.py reconcile_public_workout_operations
User=root
