[Unit]
Description=OctoBOX corredor de treinos billing notice drain
After=network-online.target octobox-gunicorn.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/octobox/current
EnvironmentFile=-/srv/octobox/current/.release.env
EnvironmentFile=-/srv/octobox/shared/octobox.env
ExecStart=/srv/octobox/current/venv/bin/python manage.py drain_public_workout_notices
User=octobox
Group=octobox
UMask=0077

[Install]
WantedBy=multi-user.target
